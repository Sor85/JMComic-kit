{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn"],
    "no-undef": ["error"],
    "no-console": ["off"],
    "eqeqeq": ["warn", "always"]
  }
}
